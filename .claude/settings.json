{
  "model": "opusplan",
  "effortLevel": "medium",
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet build)",
      "Bash(dotnet test)",
      "Bash(dotnet restore *)",
      "Bash(dotnet restore)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Read(./**/secrets.json)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/filter-test-output.sh"
          }
        ]
      }
    ]
  }
}
